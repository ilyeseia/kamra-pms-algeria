# ZIRI PMS — Linux stack configuration.
#
#   cp .env.example .env    then edit    then:  docker compose up -d
#
# NEVER COMMIT .env. It holds the database root password. The repository's
# .gitignore already excludes .env and .env.* — keep it that way.
#
# An existing install made by deploy/install.sh already has this file, written
# for you, at /opt/kamra/kamra.env. If you are moving to this directory rather
# than starting fresh, copy that one instead of writing a new password:
#   cp /opt/kamra/kamra.env .env
# Writing a new DB_PASSWORD against an existing db-data volume will NOT work —
# MariaDB keeps the password it was initialised with.

# ── Required ────────────────────────────────────────────────────────────────

# MariaDB root password. No default: the stack refuses to start without it,
# deliberately, because upstream's fallback is "123" and that is not a
# password a hotel database should quietly end up with.
# Generate one:  openssl rand -hex 16
DB_PASSWORD=

# The Frappe site name, which MUST equal the site you created with
# `bench new-site`. nginx routes on this header, so a mismatch makes every
# request 404 against a site that exists — the single most common cause of
# "it installed but shows nothing".
FRAPPE_SITE_NAME_HEADER=pms.yourhotel.dz

# ── Image ───────────────────────────────────────────────────────────────────
# Built on this machine; there is no registry to pull from, which is why the
# pull policy is never. See README.md for the build command.
CUSTOM_IMAGE=kamra
CUSTOM_TAG=local
PULL_POLICY=never

# ── Networking ──────────────────────────────────────────────────────────────
# The host port nginx is published on. Put a reverse proxy in front for TLS —
# do not serve a hotel over plain HTTP.
HTTP_PUBLISH_PORT=8080
# The port nginx listens on inside the container. Leave this alone unless you
# know why you are changing it.
NGINX_LISTEN_PORT=8080

# If a reverse proxy sits in front, these let Frappe see the real client IP
# instead of the proxy's. Set UPSTREAM_REAL_IP_ADDRESS to the proxy's address.
# UPSTREAM_REAL_IP_ADDRESS=127.0.0.1
# UPSTREAM_REAL_IP_HEADER=X-Forwarded-For
# UPSTREAM_REAL_IP_RECURSIVE=off

# ── Tuning (optional) ───────────────────────────────────────────────────────
# Raise the workers on a busy property with RAM to spare. Each worker is a
# process holding a full Python app, so do not raise it on a 4 GB box.
# GUNICORN_WORKERS=2
# GUNICORN_THREADS=4
# GUNICORN_TIMEOUT=120

# Upload ceiling. Guest ID scans and room photos go through this.
# CLIENT_MAX_BODY_SIZE=50m
# PROXY_READ_TIMEOUT=120

# unless-stopped keeps the hotel running across a reboot, which is what you
# want on a property server. Use "no" only while debugging.
# RESTART_POLICY=unless-stopped
