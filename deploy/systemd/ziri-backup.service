[Unit]
# Takes one backup set and prunes old ones. The set is written to the HOST,
# outside the Docker volumes, because the disaster this exists for is losing
# those volumes.
#
# Paths are substituted by install-timers.sh; @@ZIRI_DIR@@ is the repository
# root on this host. Do not edit this file in place - edit it in the repository
# and re-run the installer, or the next update silently reverts your change.
Description=ZIRI PMS backup set
Documentation=file://@@ZIRI_DIR@@/docs/product/BACKUP.md
# Docker must be up: the script talks to the compose project. Wants, not
# Requires, so a boot where Docker is slow still reaches this and fails
# visibly in the journal rather than being cancelled.
Wants=docker.service
After=docker.service network-online.target

[Service]
Type=oneshot
User=root
WorkingDirectory=@@ZIRI_DIR@@/deploy

# Retention is stated here and not hidden in the script's default, so an
# operator changing how much history to keep changes it where they can see it.
# 14 daily sets at the size this site produces is small; on a real property
# measure a set first - docs/product/BACKUP.md section 4.2.
Environment=KEEP_SETS=14

# flock, because verify spins a throwaway MariaDB and imports into it while
# this one dumps. Two of those at once on a hotel's single server is how a
# backup window turns into an outage. -w 1800: WAIT for the weekly verify to
# finish rather than skip the day's backup, which -n would have done.
ExecStart=/usr/bin/flock -w 1800 /run/ziri-backup.lock \
          /bin/bash @@ZIRI_DIR@@/deploy/backup-verify.sh backup

# Longer than the flock wait, or the unit would be killed while queueing.
TimeoutStartSec=5400

# A backup should lose to the front desk, never the other way round.
Nice=10
IOSchedulingClass=idle

StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
